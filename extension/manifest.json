{
  "manifest_version": 3,
  "name": "써즈 동네방네 수집기",
  "version": "1.8.2",
  "description": "로그인한 내 브라우저의 네이버 통계·쇼핑커넥트·여행 제휴 화면과, 내 키로 부른 네이버 공식 API(쇼핑 검색·데이터랩·검색광고) 결과를 써즈의 동네방네 사이트로 보내요.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "alarms",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "써즈 동네방네로 보내기",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.claudeusercontent.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "deliver.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://blog.naver.com/*"
      ],
      "js": [
        "naver-helper.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "host_permissions": [
    "https://openapi.naver.com/*",
    "https://api.searchad.naver.com/*",
    "https://blog.naver.com/*",
    "https://rss.blog.naver.com/*",
    "https://search.shopping.naver.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
